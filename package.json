{
  "name": "meal-preparation",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "version:generate": "node scripts/generate-version.mjs",
    "start": "ng serve",
    "prestart": "npm run version:generate",
    "build": "ng build",
    "prebuild": "npm run version:generate",
    "build:prod": "ng build --base-href=/meal-prep/",
    "prebuild:prod": "npm run version:generate",
    "test": "ng test --watch=false",
    "pretest": "npm run version:generate",
    "test:watch": "ng test",
    "pretest:watch": "npm run version:generate",
    "e2e": "npx playwright test",
    "pree2e": "npm run version:generate",
    "e2e:headed": "npx playwright test --headed",
    "pree2e:headed": "npm run version:generate",
    "deploy": "ng deploy --base-href=/meal-prep/",
    "worker:dev": "cd cf-worker && npm run dev",
    "worker:deploy": "cd cf-worker && npm run deploy",
    "postinstall": "npm run version:generate",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "firebase": "^12.11.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "angular-cli-ghpages": "^3.1.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
